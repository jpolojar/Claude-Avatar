{
  "name": "avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Talking 3D avatar powered by Claude, speaking Finnish and English",
  "main": "desktop/dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,web,stt -c blue,green,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:whisper\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "whisper": "node --env-file-if-exists=.env scripts/whisper.mjs",
    "widget": "npm run widget:build && concurrently --kill-others-on-fail -n server,web,stt,app -c blue,green,magenta,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:whisper\" \"npm:widget:app\"",
    "widget:build": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --format=cjs --packages=external --log-override:empty-import-meta=silent --outdir=desktop/dist --out-extension:.js=.cjs && node -e \"require('fs').copyFileSync('server/persona.md','desktop/dist/persona.md')\"",
    "widget:app": "electron desktop/dist/main.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "widget:internal": "npm run build:web && npm run widget:build && electron desktop/dist/main.cjs --internal-server",
    "dist": "npm run build:web && npm run widget:build && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "msedge-tts": "^2.0.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.jpolojar.avatar",
    "productName": "Avatar",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/dist/**/*",
      "dist/web/**/*",
      "assets/avatar.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/avatar.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Avatar"
    }
  }
}
