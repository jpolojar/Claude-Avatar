{
  "name": "avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Talking 3D avatar powered by Claude, speaking Finnish and English",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,web,stt -c blue,green,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:whisper\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "whisper": "node --env-file-if-exists=.env scripts/whisper.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test \"server/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@ricky0123/vad-web": "^0.0.31",
    "express": "^5.2.1",
    "msedge-tts": "^2.0.9",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
